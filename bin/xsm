#!/bin/sh
# Thin launcher: find the package next to this script and run the CLI.
#
# The script is meant to be symlinked onto PATH (~/.local/bin/xsm), so it has to
# follow the link chain before looking for the package — $0 is the symlink, and
# its directory is not where the code lives.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")/.." && pwd) || exit 1
if [ ! -d "$here/xsm" ]; then
    echo "xsm: no package at $here/xsm (is this launcher still next to the repo?)" >&2
    exit 4
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# Not `python -m xsm`: that puts the current directory first on sys.path, so run
# inside another xsm checkout, that checkout's code ran instead of this launcher's
# (2026-10-02). The text is xsm.install.BOOT; a test keeps the two equal.
boot='import os, sys; here = sys.argv.pop(1); cwd = os.path.realpath("."); sys.path[:] = [here] + [p for p in sys.path if p and os.path.realpath(p) != cwd]; from xsm.cli import main; sys.exit(main())'
exec "${XSM_PYTHON:-python3}" -c "$boot" "$here" "$@"
